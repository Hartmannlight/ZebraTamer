      { "current": { "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(zpl_printer_info, host)", "hide": 0, "includeAll": true, "label": "Pi", "multi": true, "name": "host", "options": [], "query": { "query": "label_values(zpl_printer_info, host)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }, "refresh": 1, "regex": "", "sort": 1, "type": "query" },
      { "current": { "text": "All", "value": "$__all" }, "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(zpl_printer_info{host=~\"$host\"}, printer)", "hide": 0, "includeAll": true, "label": "Drucker", "multi": true, "name": "printer", "options": [], "query": { "query": "label_values(zpl_printer_info{host=~\"$host\"}, printer)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }, "refresh": 1, "regex": "", "sort": 1, "type": "query" }
    ]
  },
