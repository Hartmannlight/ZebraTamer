[Unit]
Description=ZebraTamer USB print service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zpl-agent
Group=zpl-agent
SupplementaryGroups=lp
UMask=0027
ExecStart=/usr/local/bin/zpl-agent --config /etc/zpl-agent/config.toml
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zpl-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=96M
TasksMax=32

[Install]
WantedBy=multi-user.target
